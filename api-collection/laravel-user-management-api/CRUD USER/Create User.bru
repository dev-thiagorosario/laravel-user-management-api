meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/register
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Test User",
    "email": "user@example.com",
    "password": "StrongPassword123",
    "password_confirmation": "StrongPassword123"
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
